/-- The certificate for `2^1 p^1` from `p ≥ 3` (13 search nodes). -/
theorem cert_1_1 : certifyP 1 1 3 11 2 [-2, 4]
    [0, 1, 2]
    [true, true, true]
    [] = true := by
  decide +kernel

/-- **`n = 2^1 p^1`.** For every prime `p ≥ 3` and every set `S` of proper divisors of `n`,
the energy of `ICG(n, S)` is at most `-2 + 4 * p`, with equality exactly for
`{2^0 p^0, 2^0 p^1, 2^1 p^0}`. -/
theorem energy_1_1 {p : ℕ} (hp : p.Prime) (hp0 : 3 ≤ p) {S : Finset ℕ}
    (hS : S ⊆ (2 ^ 1 * p ^ 1).properDivisors) :
    ICGBridge.energy (ICGBridge.icgAdj (2 ^ 1 * p ^ 1) S) (ICGBridge.icgAdj_isHermitian _ _) ≤
        -2 + 4 * (p : ℝ) ∧
      (ICGBridge.energy (ICGBridge.icgAdj (2 ^ 1 * p ^ 1) S) (ICGBridge.icgAdj_isHermitian _ _) =
          -2 + 4 * (p : ℝ) ↔ S = {2 ^ 0 * p ^ 0, 2 ^ 0 * p ^ 1, 2 ^ 1 * p ^ 0}) := by
  have h := energy_le_of_certifyP cert_1_1 hp (by omega) hp0 hS
  have hE : ((UPoly.eval [-2, 4] (p : ℤ) : ℤ) : ℝ) = -2 + 4 * (p : ℝ) := by
    simp only [UPoly.eval_cons, UPoly.eval_nil]; push_cast; ring
  have h0 : divsOfMask 1 1 p [true, true, true] = {2 ^ 0 * p ^ 0, 2 ^ 0 * p ^ 1, 2 ^ 1 * p ^ 0} := by
    rw [show divsOfMask 1 1 p [true, true, true] =
      ([2 ^ 0 * p ^ 0, 2 ^ 0 * p ^ 1, 2 ^ 1 * p ^ 0] : List ℕ).toFinset from rfl]
    simp
  rw [hE] at h
  simpa only [List.map_cons, List.map_nil, List.mem_cons, List.not_mem_nil, or_false, h0]
    using h


import Formal.ICG.TwoPowGraph
import Formal.ICG.TwoPowTight

/-!
# The maximal energy of `ICG(2^a · 3, S)`

For `P = 3` the potential of `TwoPowChain` fails, but the exact value function of the chain is still
a maximum of affine pieces. In units of `f = 2F` it is
* `Q 0 = 2F(s, t) = max(6t, 8s - 2t)` and `Q 1 = max(4 + 4s + 2t, 6 - 4s + 4t, 6 + 4s - 4t, 8)`;
* `Q 2 = 106/9 + max(T_0, …, T_3 at ρ = 1/4, 2/9 - 2s - t, 2s + t - 25/9)`;
* `Q n = (10/3) n + 46/9 + max_i T_i((-1/2)^n)` for `n ≥ 3`, with `T_i(ρ) = L_i + ρ ψ_i`.

Every step `f + Q n (next) ≤ Q (n+1)` is proved piece by piece. For `n ≥ 3` each pair of pieces
gives a slack affine in `ρ = (-1/2)^n ∈ [-1/8, 1/16]`; at every state some right-hand piece has
nonnegative slack at both ends of that interval (`up_*`), so it has nonnegative slack throughout.
Attainment uses one covering choice of bits and next piece for each right-hand piece (`at*`).
These pieces were found by exact value iteration and checked in exact arithmetic before the proof.
The numeric lemmas are generated by `solved/lean_two_pow_three.py`: each inequality is split over
the unit square by the signs of its absolute values and, where needed, by further linear forms,
with the covering right-hand piece recorded for each cell. Lean checks every cell; the generator is
not trusted. Do not edit by hand: run `python -m scripts.lean_icg_families`.
-/

noncomputable section

-- The numeric lemmas below share one signature (the box hypotheses) so that the assembly can
-- call them positionally; some cells do not need every hypothesis.
set_option linter.unusedVariables false

namespace Solved.ICG.TwoPow

open Finset ICGGeneral

/-- The four affine pieces `L_i + ρ ψ_i` for `n ≥ 3`. -/
def Tp : ℕ → ℝ → ℝ → ℝ → ℝ
  | 0, ρ, s, t => 2 / 3 * t - 8 / 3 * s + ρ * (8 / 9 + 2 * (2 / 3 * t - 8 / 3 * s))
  | 1, ρ, s, t => 8 / 3 * s - 2 / 3 * t - 2 + ρ * (8 / 9 + 2 * (8 / 3 * s - 2 / 3 * t - 2))
  | 2, ρ, s, t => -(4 / 3) * s - 8 / 3 * t + ρ * (-(28 / 9) + 16 / 3 * s - 4 / 3 * t)
  | _, ρ, s, t => 4 / 3 * s + 8 / 3 * t - 4 + ρ * (8 / 9 - 16 / 3 * s + 4 / 3 * t)

def U3 (ρ s t : ℝ) : ℝ := max (max (Tp 0 ρ s t) (Tp 1 ρ s t)) (max (Tp 2 ρ s t) (Tp 3 ρ s t))

/-- Pieces of `Q 0`. -/
def P0 : ℕ → ℝ → ℝ → ℝ
  | 0, _, t => 6 * t
  | _, s, t => 8 * s - 2 * t

/-- Pieces of `Q 1`. -/
def P1 : ℕ → ℝ → ℝ → ℝ
  | 0, s, t => 4 + 4 * s + 2 * t
  | 1, s, t => 6 - 4 * s + 4 * t
  | 2, s, t => 6 + 4 * s - 4 * t
  | _, _, _ => 8

/-- Pieces of `Q 2`. -/
def P2 : ℕ → ℝ → ℝ → ℝ
  | 4, s, t => 106 / 9 + (2 / 9 - 2 * s - t)
  | 5, s, t => 106 / 9 + (2 * s + t - 25 / 9)
  | i, s, t => 106 / 9 + Tp i (1 / 4) s t

def V1 (s t : ℝ) : ℝ := max (max (P1 0 s t) (P1 1 s t)) (max (P1 2 s t) (P1 3 s t))

def Q2 (s t : ℝ) : ℝ :=
  max (max (max (P2 0 s t) (P2 1 s t)) (max (P2 2 s t) (P2 3 s t))) (max (P2 4 s t) (P2 5 s t))

/-- The value function of the chain at `P = 3`, in units of `f = 2F`. -/
def Q3 : ℕ → ℝ → ℝ → ℝ
  | 0, s, t => max (P0 0 s t) (P0 1 s t)
  | 1, s, t => V1 s t
  | 2, s, t => Q2 s t
  | n + 3, s, t => 10 / 3 * (n + 3 : ℕ) + 46 / 9 + U3 ((-1 / 2 : ℝ) ^ (n + 3)) s t

/-- Slack of a step from piece `i` of the next state to piece `j` of the current state. -/
def slk (z w : ℝ) (i j : ℕ) (ρ s t : ℝ) : ℝ :=
  10 / 3 + Tp j (-1 / 2 * ρ) s t - 2 * Fp 3 ((z - s) / 2) ((w - t) / 2) -
    Tp i ρ ((s + z) / 2) ((t + w) / 2)

/-- Slack of attainment for piece `i` of the current state, with bits `(z, w)` and piece `k`. -/
def slkA (z w : ℝ) (i k : ℕ) (ρ s t : ℝ) : ℝ :=
  2 * Fp 3 ((z - s) / 2) ((w - t) / 2) + Tp k ρ ((s + z) / 2) ((t + w) / 2) - 10 / 3 -
    Tp i (-1 / 2 * ρ) s t

theorem up01_00_0 {s t : ℝ} (hs0 : 0 ≤ s) (hs1 : s ≤ 1) (ht0 : 0 ≤ t) (ht1 : t ≤ 1) :
    2 * Fp 3 ((0 - s) / 2) ((0 - t) / 2) + P0 0 ((s + 0) / 2) ((t + 0) / 2) ≤
      V1 s t := by
  unfold Fp V1
  simp only [P0, P1]
  rcases le_total 0 ((0 - t) / 2 - (0 - s) / 2) with h1 | h1
  · rw [abs_of_nonneg h1]
    rcases le_total 0 ((3 - 1) * ((0 - s) / 2) + (0 - t) / 2) with h2 | h2
    · rw [abs_of_nonneg h2]
      refine le_trans ?_ ((le_max_left _ _).trans (le_max_left _ _))
      linarith
    · rw [abs_of_nonpos h2]
      refine le_trans ?_ ((le_max_left _ _).trans (le_max_left _ _))
      linarith
  · rw [abs_of_nonpos h1]
    rcases le_total 0 ((3 - 1) * ((0 - s) / 2) + (0 - t) / 2) with h2 | h2
    · rw [abs_of_nonneg h2]
      refine le_trans ?_ ((le_max_left _ _).trans (le_max_left _ _))
      linarith
    · rw [abs_of_nonpos h2]
      refine le_trans ?_ ((le_max_left _ _).trans (le_max_left _ _))
      linarith


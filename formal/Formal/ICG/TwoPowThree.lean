    · obtain ⟨hlo, hhi⟩ := le_min_iff.1 h
      have e := slk_mid hρ0 hρ1 hlo hhi
      unfold slk at e
      have := Tp_le_U3 (j := 1) (by norm_num) (-1 / 2 * ρ) s t

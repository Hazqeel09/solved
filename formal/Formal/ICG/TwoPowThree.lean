theorem add_max_le' {F a b c : ℝ} (h1 : F + a ≤ c) (h2 : F + b ≤ c) : F + max a b ≤ c := by
  rcases max_choice a b with h | h <;> rw [h] <;> assumption

theorem Q3_zero (s t : ℝ) : Q3 0 s t = max (P0 0 s t) (P0 1 s t) := rfl
theorem Q3_one (s t : ℝ) : Q3 1 s t = V1 s t := rfl
theorem Q3_two (s t : ℝ) : Q3 2 s t = Q2 s t := rfl
theorem Q3_add3 (m : ℕ) (s t : ℝ) :
    Q3 (m + 3) s t = 10 / 3 * ((m + 3 : ℕ) : ℝ) + 46 / 9 + U3 ((-1 / 2 : ℝ) ^ (m + 3)) s t := rfl
theorem Q3_three (s t : ℝ) : Q3 3 s t = 10 + 46 / 9 + U3 (-1 / 8) s t := by
  rw [show (3 : ℕ) = 0 + 3 from rfl, Q3_add3]; norm_num

theorem step0 {s t z w : ℝ} (hs0 : 0 ≤ s) (hs1 : s ≤ 1) (ht0 : 0 ≤ t) (ht1 : t ≤ 1)
    (hz : z = 0 ∨ z = 1) (hw : w = 0 ∨ w = 1) :
    2 * Fp 3 ((z - s) / 2) ((w - t) / 2) + Q3 0 ((s + z) / 2) ((t + w) / 2) ≤ Q3 1 s t := by
  rw [Q3_zero, Q3_one]
  rcases hz with rfl | rfl <;> rcases hw with rfl | rfl
  · exact add_max_le' (up01_00_0 hs0 hs1 ht0 ht1) (up01_00_1 hs0 hs1 ht0 ht1)
  · exact add_max_le' (up01_01_0 hs0 hs1 ht0 ht1) (up01_01_1 hs0 hs1 ht0 ht1)
  · exact add_max_le' (up01_10_0 hs0 hs1 ht0 ht1) (up01_10_1 hs0 hs1 ht0 ht1)
  · exact add_max_le' (up01_11_0 hs0 hs1 ht0 ht1) (up01_11_1 hs0 hs1 ht0 ht1)

theorem step1 {s t z w : ℝ} (hs0 : 0 ≤ s) (hs1 : s ≤ 1) (ht0 : 0 ≤ t) (ht1 : t ≤ 1)
    (hz : z = 0 ∨ z = 1) (hw : w = 0 ∨ w = 1) :
    2 * Fp 3 ((z - s) / 2) ((w - t) / 2) + Q3 1 ((s + z) / 2) ((t + w) / 2) ≤ Q3 2 s t := by
  rw [Q3_one, Q3_two, V1]
  rcases hz with rfl | rfl <;> rcases hw with rfl | rfl
  · exact add_max_le' (add_max_le' (up12_00_0 hs0 hs1 ht0 ht1) (up12_00_1 hs0 hs1 ht0 ht1))
      (add_max_le' (up12_00_2 hs0 hs1 ht0 ht1) (up12_00_3 hs0 hs1 ht0 ht1))
  · exact add_max_le' (add_max_le' (up12_01_0 hs0 hs1 ht0 ht1) (up12_01_1 hs0 hs1 ht0 ht1))
      (add_max_le' (up12_01_2 hs0 hs1 ht0 ht1) (up12_01_3 hs0 hs1 ht0 ht1))
  · exact add_max_le' (add_max_le' (up12_10_0 hs0 hs1 ht0 ht1) (up12_10_1 hs0 hs1 ht0 ht1))
      (add_max_le' (up12_10_2 hs0 hs1 ht0 ht1) (up12_10_3 hs0 hs1 ht0 ht1))
  · exact add_max_le' (add_max_le' (up12_11_0 hs0 hs1 ht0 ht1) (up12_11_1 hs0 hs1 ht0 ht1))
      (add_max_le' (up12_11_2 hs0 hs1 ht0 ht1) (up12_11_3 hs0 hs1 ht0 ht1))

theorem step2 {s t z w : ℝ} (hs0 : 0 ≤ s) (hs1 : s ≤ 1) (ht0 : 0 ≤ t) (ht1 : t ≤ 1)
    (hz : z = 0 ∨ z = 1) (hw : w = 0 ∨ w = 1) :
    2 * Fp 3 ((z - s) / 2) ((w - t) / 2) + Q3 2 ((s + z) / 2) ((t + w) / 2) ≤ Q3 3 s t := by
  rw [Q3_two, Q3_three, Q2]
  rcases hz with rfl | rfl <;> rcases hw with rfl | rfl
  · exact add_max_le' (add_max_le' (add_max_le' (up23_00_0 hs0 hs1 ht0 ht1) (up23_00_1 hs0 hs1 ht0 ht1))
      (add_max_le' (up23_00_2 hs0 hs1 ht0 ht1) (up23_00_3 hs0 hs1 ht0 ht1))) (add_max_le' (up23_00_4 hs0 hs1 ht0 ht1) (up23_00_5 hs0 hs1 ht0 ht1))
  · exact add_max_le' (add_max_le' (add_max_le' (up23_01_0 hs0 hs1 ht0 ht1) (up23_01_1 hs0 hs1 ht0 ht1))
      (add_max_le' (up23_01_2 hs0 hs1 ht0 ht1) (up23_01_3 hs0 hs1 ht0 ht1))) (add_max_le' (up23_01_4 hs0 hs1 ht0 ht1) (up23_01_5 hs0 hs1 ht0 ht1))
  · exact add_max_le' (add_max_le' (add_max_le' (up23_10_0 hs0 hs1 ht0 ht1) (up23_10_1 hs0 hs1 ht0 ht1))
      (add_max_le' (up23_10_2 hs0 hs1 ht0 ht1) (up23_10_3 hs0 hs1 ht0 ht1))) (add_max_le' (up23_10_4 hs0 hs1 ht0 ht1) (up23_10_5 hs0 hs1 ht0 ht1))
  · exact add_max_le' (add_max_le' (add_max_le' (up23_11_0 hs0 hs1 ht0 ht1) (up23_11_1 hs0 hs1 ht0 ht1))
      (add_max_le' (up23_11_2 hs0 hs1 ht0 ht1) (up23_11_3 hs0 hs1 ht0 ht1))) (add_max_le' (up23_11_4 hs0 hs1 ht0 ht1) (up23_11_5 hs0 hs1 ht0 ht1))

theorem stepN {m : ℕ} {s t z w : ℝ} (hs0 : 0 ≤ s) (hs1 : s ≤ 1) (ht0 : 0 ≤ t) (ht1 : t ≤ 1)
    (hz : z = 0 ∨ z = 1) (hw : w = 0 ∨ w = 1) :
    2 * Fp 3 ((z - s) / 2) ((w - t) / 2) + Q3 (m + 3) ((s + z) / 2) ((t + w) / 2) ≤
      Q3 (m + 3 + 1) s t := by
  obtain ⟨hρ0, hρ1⟩ := rho_bounds (n := m + 3) (by omega)
  have key : 2 * Fp 3 ((z - s) / 2) ((w - t) / 2) +
      U3 ((-1 / 2 : ℝ) ^ (m + 3)) ((s + z) / 2) ((t + w) / 2) ≤
      10 / 3 + U3 (-1 / 2 * (-1 / 2 : ℝ) ^ (m + 3)) s t := by
    unfold U3
    rcases hz with rfl | rfl <;> rcases hw with rfl | rfl
    · exact add_max_le' (add_max_le' (stepU_00_0 hs0 hs1 ht0 ht1 hρ0 hρ1) (stepU_00_1 hs0 hs1 ht0 ht1 hρ0 hρ1))
        (add_max_le' (stepU_00_2 hs0 hs1 ht0 ht1 hρ0 hρ1) (stepU_00_3 hs0 hs1 ht0 ht1 hρ0 hρ1))
    · exact add_max_le' (add_max_le' (stepU_01_0 hs0 hs1 ht0 ht1 hρ0 hρ1) (stepU_01_1 hs0 hs1 ht0 ht1 hρ0 hρ1))
        (add_max_le' (stepU_01_2 hs0 hs1 ht0 ht1 hρ0 hρ1) (stepU_01_3 hs0 hs1 ht0 ht1 hρ0 hρ1))
    · exact add_max_le' (add_max_le' (stepU_10_0 hs0 hs1 ht0 ht1 hρ0 hρ1) (stepU_10_1 hs0 hs1 ht0 ht1 hρ0 hρ1))
        (add_max_le' (stepU_10_2 hs0 hs1 ht0 ht1 hρ0 hρ1) (stepU_10_3 hs0 hs1 ht0 ht1 hρ0 hρ1))
    · exact add_max_le' (add_max_le' (stepU_11_0 hs0 hs1 ht0 ht1 hρ0 hρ1) (stepU_11_1 hs0 hs1 ht0 ht1 hρ0 hρ1))
        (add_max_le' (stepU_11_2 hs0 hs1 ht0 ht1 hρ0 hρ1) (stepU_11_3 hs0 hs1 ht0 ht1 hρ0 hρ1))
  rw [show m + 3 + 1 = (m + 1) + 3 by omega, Q3_add3, Q3_add3]
  rw [show (-1 / 2 : ℝ) ^ (m + 1 + 3) = -1 / 2 * (-1 / 2 : ℝ) ^ (m + 3) by ring]
  push_cast
  linarith

/-- The step from `n` to `n + 1`. -/
theorem Q3_step (n : ℕ) {s t z w : ℝ} (hs0 : 0 ≤ s) (hs1 : s ≤ 1) (ht0 : 0 ≤ t) (ht1 : t ≤ 1)
    (hz : z = 0 ∨ z = 1) (hw : w = 0 ∨ w = 1) :
    2 * Fp 3 ((z - s) / 2) ((w - t) / 2) + Q3 n ((s + z) / 2) ((t + w) / 2) ≤ Q3 (n + 1) s t := by
  match n with
  | 0 => exact step0 hs0 hs1 ht0 ht1 hz hw
  | 1 => exact step1 hs0 hs1 ht0 ht1 hz hw
  | 2 => exact step2 hs0 hs1 ht0 ht1 hz hw
  | m + 3 => exact stepN hs0 hs1 ht0 ht1 hz hw

theorem max4_piece (f : ℕ → ℝ) :
    ∃ j ≤ 3, max (max (f 0) (f 1)) (max (f 2) (f 3)) = f j := by
  rcases max_choice (f 0) (f 1) with h1 | h1 <;>
    rcases max_choice (f 2) (f 3) with h2 | h2 <;>
    rcases max_choice (max (f 0) (f 1)) (max (f 2) (f 3)) with h | h <;>
    rw [h] <;> first
      | (rw [h1]; exact ⟨_, by norm_num, rfl⟩)
      | (rw [h2]; exact ⟨_, by norm_num, rfl⟩)

theorem Q2_piece (s t : ℝ) : ∃ j ≤ 5, Q2 s t = P2 j s t := by
  unfold Q2
  obtain ⟨j, hj, h⟩ := max4_piece (fun i => P2 i s t)
  rcases max_choice (max (max (P2 0 s t) (P2 1 s t)) (max (P2 2 s t) (P2 3 s t)))
      (max (P2 4 s t) (P2 5 s t)) with h' | h'
  · rw [h', h]; exact ⟨j, by omega, rfl⟩
  · rw [h']
    rcases max_choice (P2 4 s t) (P2 5 s t) with h'' | h''
    · rw [h'']; exact ⟨4, by norm_num, rfl⟩
    · rw [h'']; exact ⟨5, by norm_num, rfl⟩

theorem le_max4 (f : ℕ → ℝ) {j : ℕ} (hj : j ≤ 3) : f j ≤ max (max (f 0) (f 1)) (max (f 2) (f 3)) := by
  interval_cases j
  · exact (le_max_left _ _).trans (le_max_left _ _)
  · exact (le_max_right _ _).trans (le_max_left _ _)
  · exact (le_max_left _ _).trans (le_max_right _ _)
  · exact (le_max_right _ _).trans (le_max_right _ _)

theorem P2_le_Q2 {j : ℕ} (hj : j ≤ 5) (s t : ℝ) : P2 j s t ≤ Q2 s t := by
  unfold Q2
  rcases Nat.lt_or_ge j 4 with h | h
  · exact (le_max4 (fun i => P2 i s t) (by omega)).trans (le_max_left _ _)
  · obtain rfl | rfl : j = 4 ∨ j = 5 := by omega
    · exact (le_max_left _ _).trans (le_max_right _ _)
    · exact (le_max_right _ _).trans (le_max_right _ _)

/-- Attainment of the step from `n` to `n + 1`: some bits make it an equality. -/
theorem Q3_attain (n : ℕ) {s t : ℝ} (hs0 : 0 ≤ s) (hs1 : s ≤ 1) (ht0 : 0 ≤ t) (ht1 : t ≤ 1) :
    ∃ z w : ℝ, (z = 0 ∨ z = 1) ∧ (w = 0 ∨ w = 1) ∧
      Q3 (n + 1) s t ≤ 2 * Fp 3 ((z - s) / 2) ((w - t) / 2) + Q3 n ((s + z) / 2) ((t + w) / 2) := by
  match n with
  | 0 =>
    simp only [zero_add, Q3_zero, Q3_one, V1]
    obtain ⟨j, hj, h⟩ := max4_piece (fun i => P1 i s t)
    rw [h]
    interval_cases j
    · exact ⟨1, 0, Or.inr rfl, Or.inl rfl, (at01_0 hs0 hs1 ht0 ht1).trans (by gcongr; exact le_max_right _ _)⟩
    · exact ⟨1, 1, Or.inr rfl, Or.inr rfl, (at01_1 hs0 hs1 ht0 ht1).trans (by gcongr; exact le_max_left _ _)⟩
    · exact ⟨1, 1, Or.inr rfl, Or.inr rfl, (at01_2 hs0 hs1 ht0 ht1).trans (by gcongr; exact le_max_right _ _)⟩
    · exact ⟨1, 0, Or.inr rfl, Or.inl rfl, (at01_3 hs0 hs1 ht0 ht1).trans (by gcongr; exact le_max_right _ _)⟩
  | 1 =>
    simp only [Nat.reduceAdd, Q3_one, Q3_two]
    obtain ⟨j, hj, h⟩ := Q2_piece s t
    rw [h]
    have L := fun {i : ℕ} (hi : i ≤ 3) (x y : ℝ) => le_max4 (fun k => P1 k x y) hi
    interval_cases j
    · exact ⟨1, 0, Or.inr rfl, Or.inl rfl, (at12_0 hs0 hs1 ht0 ht1).trans (by gcongr; exact L (by norm_num) _ _)⟩
    · exact ⟨0, 1, Or.inl rfl, Or.inr rfl, (at12_1 hs0 hs1 ht0 ht1).trans (by gcongr; exact L (by norm_num) _ _)⟩
    · exact ⟨0, 1, Or.inl rfl, Or.inr rfl, (at12_2 hs0 hs1 ht0 ht1).trans (by gcongr; exact L (by norm_num) _ _)⟩
    · exact ⟨0, 0, Or.inl rfl, Or.inl rfl, (at12_3 hs0 hs1 ht0 ht1).trans (by gcongr; exact L (by norm_num) _ _)⟩
    · exact ⟨1, 0, Or.inr rfl, Or.inl rfl, (at12_4 hs0 hs1 ht0 ht1).trans (by gcongr; exact L (by norm_num) _ _)⟩
    · exact ⟨0, 1, Or.inl rfl, Or.inr rfl, (at12_5 hs0 hs1 ht0 ht1).trans (by gcongr; exact L (by norm_num) _ _)⟩
  | 2 =>
    simp only [Nat.reduceAdd, Q3_two, Q3_three, U3]
    obtain ⟨j, hj, h⟩ := max4_piece (fun i => Tp i (-1 / 8) s t)
    rw [h]
    interval_cases j
    · exact ⟨1, 0, Or.inr rfl, Or.inl rfl, by
        have := at23_0 hs0 hs1 ht0 ht1; have := P2_le_Q2 (j := 1) (by norm_num) ((s + 1) / 2) ((t + 0) / 2)
        linarith⟩
    · exact ⟨0, 1, Or.inl rfl, Or.inr rfl, by
        have := at23_1 hs0 hs1 ht0 ht1; have := P2_le_Q2 (j := 0) (by norm_num) ((s + 0) / 2) ((t + 1) / 2)
        linarith⟩
    · exact ⟨0, 1, Or.inl rfl, Or.inr rfl, by
        have := at23_2 hs0 hs1 ht0 ht1; have := P2_le_Q2 (j := 0) (by norm_num) ((s + 0) / 2) ((t + 1) / 2)
        linarith⟩
    · exact ⟨1, 0, Or.inr rfl, Or.inl rfl, by
        have := at23_3 hs0 hs1 ht0 ht1; have := P2_le_Q2 (j := 1) (by norm_num) ((s + 1) / 2) ((t + 0) / 2)
        linarith⟩
  | m + 3 =>
    obtain ⟨hρ0, hρ1⟩ := rho_bounds (n := m + 3) (by omega)
    rw [show m + 3 + 1 = (m + 1) + 3 by omega]
    simp only [Q3_add3]
    rw [show (-1 / 2 : ℝ) ^ (m + 1 + 3) = -1 / 2 * (-1 / 2 : ℝ) ^ (m + 3) by ring]
    obtain ⟨j, hj, h⟩ := U3_piece (-1 / 2 * (-1 / 2 : ℝ) ^ (m + 3)) s t
    rw [h]
    have hc : (10 : ℝ) / 3 * ((m + 1 + 3 : ℕ) : ℝ) = 10 / 3 * ((m + 3 : ℕ) : ℝ) + 10 / 3 := by
      push_cast; ring
    rw [hc]
    interval_cases j
    · refine ⟨1, 0, Or.inr rfl, Or.inl rfl, ?_⟩
      have e := slkA_mid hρ0 hρ1 (atr_0_lo hs0 hs1 ht0 ht1) (atr_0_hi hs0 hs1 ht0 ht1)
      unfold slkA at e
      have := Tp_le_U3 (j := 1) (by norm_num) ((-1 / 2 : ℝ) ^ (m + 3)) ((s + 1) / 2) ((t + 0) / 2)
      linarith
    · refine ⟨0, 1, Or.inl rfl, Or.inr rfl, ?_⟩
      have e := slkA_mid hρ0 hρ1 (atr_1_lo hs0 hs1 ht0 ht1) (atr_1_hi hs0 hs1 ht0 ht1)
      unfold slkA at e
      have := Tp_le_U3 (j := 0) (by norm_num) ((-1 / 2 : ℝ) ^ (m + 3)) ((s + 0) / 2) ((t + 1) / 2)
      linarith
    · refine ⟨0, 1, Or.inl rfl, Or.inr rfl, ?_⟩
      have e := slkA_mid hρ0 hρ1 (atr_2_lo hs0 hs1 ht0 ht1) (atr_2_hi hs0 hs1 ht0 ht1)
      unfold slkA at e
      have := Tp_le_U3 (j := 0) (by norm_num) ((-1 / 2 : ℝ) ^ (m + 3)) ((s + 0) / 2) ((t + 1) / 2)
      linarith
    · refine ⟨1, 0, Or.inr rfl, Or.inl rfl, ?_⟩
      have e := slkA_mid hρ0 hρ1 (atr_3_lo hs0 hs1 ht0 ht1) (atr_3_hi hs0 hs1 ht0 ht1)
      unfold slkA at e
      have := Tp_le_U3 (j := 1) (by norm_num) ((-1 / 2 : ℝ) ^ (m + 3)) ((s + 1) / 2) ((t + 0) / 2)
      linarith

theorem Q3_base {s t : ℝ} (hs0 : 0 ≤ s) (ht0 : 0 ≤ t) : Q3 0 s t = 2 * Fp 3 s t := by
  rw [Q3_zero]; simp only [P0, Fp]
  rw [abs_of_nonneg (by linarith : (0 : ℝ) ≤ (3 - 1) * s + t)]
  rcases le_total s t with h | h
  · rw [abs_of_nonneg (by linarith : (0 : ℝ) ≤ t - s), max_eq_left (by linarith)]; ring
  · rw [abs_of_nonpos (by linarith : t - s ≤ 0), max_eq_right (by linarith)]; ring

open Finset in
/-- The chain bound at `P = 3`. -/
theorem chain3_le {σ τ z w : ℕ → ℝ} {n : ℕ}
    (hz : ∀ k < n, z k = 0 ∨ z k = 1) (hw : ∀ k < n, w k = 0 ∨ w k = 1)
    (hσ : ∀ k < n, σ k = (σ (k + 1) + z k) / 2) (hτ : ∀ k < n, τ k = (τ (k + 1) + w k) / 2)
    (hs0 : 0 ≤ σ n) (hs1 : σ n ≤ 1) (ht0 : 0 ≤ τ n) (ht1 : τ n ≤ 1) :
    2 * (Fp 3 (σ 0) (τ 0) + ∑ k ∈ range n, Fp 3 (σ k - σ (k + 1)) (τ k - τ (k + 1))) ≤
      Q3 n (σ n) (τ n) := by
  induction n with
  | zero => simp only [Finset.range_zero, Finset.sum_empty, add_zero]; rw [Q3_base hs0 ht0]
  | succ n ih =>
    have hzn := hz n (by omega); have hwn := hw n (by omega)
    have en := hσ n (by omega); have fn := hτ n (by omega)
    obtain ⟨hs0', hs1'⟩ := state_bounds hzn en hs0 hs1
    obtain ⟨ht0', ht1'⟩ := state_bounds hwn fn ht0 ht1
    have ih' := ih (fun k hk => hz k (by omega)) (fun k hk => hw k (by omega))
      (fun k hk => hσ k (by omega)) (fun k hk => hτ k (by omega)) hs0' hs1' ht0' ht1'
    have hst := Q3_step n hs0 hs1 ht0 ht1 hzn hwn
    rw [Finset.sum_range_succ,
      show σ n - σ (n + 1) = (z n - σ (n + 1)) / 2 by rw [en]; ring,
      show τ n - τ (n + 1) = (w n - τ (n + 1)) / 2 by rw [fn]; ring]
    rw [en, fn] at ih'
    linarith

open Finset in
/-- Attainment at `P = 3`: every top state has bits whose chain sum reaches `Q3 n`. -/
theorem chain3_attain {n : ℕ} {s t : ℝ} (hs0 : 0 ≤ s) (hs1 : s ≤ 1) (ht0 : 0 ≤ t) (ht1 : t ≤ 1) :
    ∃ σ τ z w : ℕ → ℝ, (∀ k < n, z k = 0 ∨ z k = 1) ∧ (∀ k < n, w k = 0 ∨ w k = 1) ∧
      (∀ k < n, σ k = (σ (k + 1) + z k) / 2) ∧ (∀ k < n, τ k = (τ (k + 1) + w k) / 2) ∧
      σ n = s ∧ τ n = t ∧
      Q3 n s t ≤ 2 * (Fp 3 (σ 0) (τ 0) + ∑ k ∈ range n, Fp 3 (σ k - σ (k + 1)) (τ k - τ (k + 1))) := by
  induction n generalizing s t with
  | zero =>
    refine ⟨fun _ => s, fun _ => t, fun _ => 0, fun _ => 0, fun k hk => absurd hk (by omega),
      fun k hk => absurd hk (by omega), fun k hk => absurd hk (by omega),
      fun k hk => absurd hk (by omega), rfl, rfl, ?_⟩
    simp only [Finset.range_zero, Finset.sum_empty, add_zero]; rw [Q3_base hs0 ht0]
  | succ n ih =>
    obtain ⟨z₀, w₀, hz₀, hw₀, hst⟩ := Q3_attain n hs0 hs1 ht0 ht1
    have hs0' : 0 ≤ (s + z₀) / 2 := by rcases hz₀ with h | h <;> rw [h] <;> linarith
    have hs1' : (s + z₀) / 2 ≤ 1 := by rcases hz₀ with h | h <;> rw [h] <;> linarith
    have ht0' : 0 ≤ (t + w₀) / 2 := by rcases hw₀ with h | h <;> rw [h] <;> linarith
    have ht1' : (t + w₀) / 2 ≤ 1 := by rcases hw₀ with h | h <;> rw [h] <;> linarith
    obtain ⟨σ, τ, z, w, hz, hw, hσ, hτ, hσn, hτn, hsum⟩ := ih hs0' hs1' ht0' ht1'
    refine ⟨Function.update σ (n + 1) s, Function.update τ (n + 1) t, Function.update z n z₀,
      Function.update w n w₀, ?_, ?_, ?_, ?_, by simp, by simp, ?_⟩
    · intro k hk
      rcases Nat.lt_succ_iff_lt_or_eq.1 hk with hk | rfl
      · rw [Function.update_of_ne hk.ne]; exact hz k hk
      · simpa using hz₀
    · intro k hk
      rcases Nat.lt_succ_iff_lt_or_eq.1 hk with hk | rfl
      · rw [Function.update_of_ne hk.ne]; exact hw k hk
      · simpa using hw₀
    · intro k hk
      rcases Nat.lt_succ_iff_lt_or_eq.1 hk with hk | rfl
      · rw [Function.update_of_ne (by omega), Function.update_of_ne (by omega),
          Function.update_of_ne hk.ne]
        exact hσ k hk
      · simp [hσn]
    · intro k hk
      rcases Nat.lt_succ_iff_lt_or_eq.1 hk with hk | rfl
      · rw [Function.update_of_ne (by omega), Function.update_of_ne (by omega),
          Function.update_of_ne hk.ne]
        exact hτ k hk
      · simp [hτn]
    · rw [Finset.sum_range_succ]
      have hk : ∀ k ∈ range n, Fp 3 (Function.update σ (n + 1) s k -
            Function.update σ (n + 1) s (k + 1))
          (Function.update τ (n + 1) t k - Function.update τ (n + 1) t (k + 1)) =
          Fp 3 (σ k - σ (k + 1)) (τ k - τ (k + 1)) := by
        intro k hk
        have hk' := Finset.mem_range.1 hk
        rw [Function.update_of_ne (by omega), Function.update_of_ne (by omega),
          Function.update_of_ne (by omega), Function.update_of_ne (by omega)]
      have a1 : Function.update σ (n + 1) s 0 = σ 0 := Function.update_of_ne (by omega) _ _
      have a2 : Function.update τ (n + 1) t 0 = τ 0 := Function.update_of_ne (by omega) _ _
      have a3 : Function.update σ (n + 1) s n = σ n := Function.update_of_ne (by omega) _ _
      have a4 : Function.update τ (n + 1) t n = τ n := Function.update_of_ne (by omega) _ _
      rw [Finset.sum_congr rfl hk, a1, a2, a3, a4, Function.update_self, Function.update_self,
        hσn, hτn]
      have : Fp 3 ((s + z₀) / 2 - s) ((t + w₀) / 2 - t) = Fp 3 ((z₀ - s) / 2) ((w₀ - t) / 2) := by
        congr 1 <;> ring
      rw [this]
      linarith

/-- The top state: `2^(a-1) Q3 a 1 0 = c_a · 3 - d_a`, and `z_a = 0` is no better. -/
theorem Q3_top {a : ℕ} (ha : 2 ≤ a) :
    Q3 a 0 0 ≤ Q3 a 1 0 ∧ 2 ^ (a - 1) * Q3 a 1 0 = Emax 3 a := by
  rcases Nat.lt_or_ge a 3 with h | h
  · obtain rfl : a = 2 := by omega
    rw [Q3_two, Q3_two]; unfold Q2 Emax; simp only [P2, Tp]; norm_num
  · obtain ⟨m, rfl⟩ : ∃ m, a = m + 3 := ⟨a - 3, by omega⟩
    obtain ⟨hρ0, hρ1⟩ := rho_bounds (n := m + 3) (by omega)
    rw [Q3_add3, Q3_add3]
    have h1 : U3 ((-1 / 2 : ℝ) ^ (m + 3)) 1 0 = 2 / 3 + 20 / 9 * (-1 / 2 : ℝ) ^ (m + 3) := by
      have e : Tp 1 ((-1 / 2 : ℝ) ^ (m + 3)) 1 0 = 2 / 3 + 20 / 9 * (-1 / 2 : ℝ) ^ (m + 3) := by
        simp only [Tp]; ring
      rw [← e]
      refine le_antisymm ?_ (Tp_le_U3 (by norm_num) _ _ _)
      unfold U3
      refine max_le (max_le ?_ le_rfl) (max_le ?_ ?_) <;> simp only [Tp] <;> nlinarith
    have h0 : U3 ((-1 / 2 : ℝ) ^ (m + 3)) 0 0 ≤ 2 / 3 + 20 / 9 * (-1 / 2 : ℝ) ^ (m + 3) := by
      unfold U3; simp only [Tp]
      refine max_le (max_le ?_ ?_) (max_le ?_ ?_) <;> nlinarith
    refine ⟨by linarith, ?_⟩
    rw [h1]; unfold Emax
    have hpow : (2 : ℝ) ^ (m + 3) * (-1 / 2 : ℝ) ^ (m + 3) = (-1) ^ (m + 3) := by
      rw [← mul_pow]; norm_num
    rw [show m + 3 - 1 = m + 2 by omega]
    have h2 : (2 : ℝ) ^ (m + 3) = 2 * 2 ^ (m + 2) := by rw [pow_succ]; ring
    push_cast
    rw [h2] at hpow ⊢
    linear_combination (10 / 9 : ℝ) * hpow

/-! ## Graph energy at `P = 3` -/

/-- **Upper bound for `n = 2^a · 3`.** -/
theorem energy_le_three {a : ℕ} (ha : 2 ≤ a) {S : Finset ℕ} (hS : S ⊆ (2 ^ a * 3).properDivisors) :
    ICGBridge.energy (ICGBridge.icgAdj (2 ^ a * 3) S) (ICGBridge.icgAdj_isHermitian _ _) ≤
      Emax 3 a := by
  have hP : Nat.Prime 3 := by norm_num
  have h := energy_eq_chain 3 a hP (by norm_num) S
  push_cast at h
  rw [h]
  have htop := not_mem_top hS
  have hc := chain3_le (σ := fun k => zeta 2 a (Ys 3 S) k 0) (τ := fun k => zeta 2 a (Ys 3 S) k 1)
    (z := fun k => Ys 3 S k 0) (w := fun k => Ys 3 S k 1) (n := a)
    (fun k _ => Ys_bit 3 S k 0) (fun k _ => Ys_bit 3 S k 1) (fun k hk => zeta_rec_two 3 S 0 hk)
    (fun k hk => zeta_rec_two 3 S 1 hk)
    (by simp only [zeta_last]; rcases Ys_bit 3 S a 0 with h | h <;> simp [h])
    (by simp only [zeta_last]; rcases Ys_bit 3 S a 0 with h | h <;> simp [h])
    (by simp only [zeta_last, htop]; norm_num) (by simp only [zeta_last, htop]; norm_num)
  simp only [zeta_last, htop] at hc
  obtain ⟨h01, htop'⟩ := Q3_top ha
  have hz : Q3 a (Ys 3 S a 0) 0 ≤ Q3 a 1 0 := by
    rcases Ys_bit 3 S a 0 with h0 | h0
    · rw [h0]; exact h01
    · rw [h0]
  have h2 : (2 : ℝ) ^ a = 2 * 2 ^ (a - 1) := by
    rw [← pow_succ']; congr 1; omega
  rw [← htop', h2]
  nlinarith [pow_pos (by norm_num : (0 : ℝ) < 2) (a - 1)]

/-- **The maximal energy of `ICG(2^a · 3, S)`.** For every `a ≥ 2`,
`max_S E(ICG(2^a · 3, S)) = 3 c_a - d_a`. -/
theorem energy_max_three {a : ℕ} (ha : 2 ≤ a) :
    (∀ S ⊆ (2 ^ a * 3).properDivisors,
      ICGBridge.energy (ICGBridge.icgAdj (2 ^ a * 3) S) (ICGBridge.icgAdj_isHermitian _ _) ≤
        Emax 3 a) ∧
    ∃ S ⊆ (2 ^ a * 3).properDivisors,
      ICGBridge.energy (ICGBridge.icgAdj (2 ^ a * 3) S) (ICGBridge.icgAdj_isHermitian _ _) =
        Emax 3 a := by
  refine ⟨fun S hS => energy_le_three ha hS, ?_⟩
  have hP : Nat.Prime 3 := by norm_num
  obtain ⟨σ, τ, z, w, hz, hw, hσ, hτ, hσa, hτa, hsum⟩ :=
    chain3_attain (n := a) (s := 1) (t := 0) (by norm_num) le_rfl le_rfl (by norm_num)
  set S := setOf 3 a z w
  refine ⟨S, setOf_sub hP z w, le_antisymm (energy_le_three ha (setOf_sub hP z w)) ?_⟩
  have hY := fun {c : ℕ} (hc : c ≤ a) => Ys_setOf hP (by norm_num) hz hw hc
  have hpath : ∀ j ≤ a, zeta 2 a (Ys 3 S) (a - j) 0 = σ (a - j) ∧
      zeta 2 a (Ys 3 S) (a - j) 1 = τ (a - j) := by
    intro j hj
    induction j with
    | zero =>
      rw [Nat.sub_zero, zeta_last, zeta_last, (hY le_rfl).1, (hY le_rfl).2, ite_eq_left rfl,
        ite_eq_left rfl, hσa, hτa]
      exact ⟨rfl, rfl⟩
    | succ j ih =>
      obtain ⟨ih0, ih1⟩ := ih (by omega)
      have hk : a - (j + 1) < a := by omega
      have hk1 : a - (j + 1) + 1 = a - j := by omega
      have hne : a - (j + 1) ≠ a := by omega
      rw [zeta_rec_two 3 S 0 hk, zeta_rec_two 3 S 1 hk, hk1, ih0, ih1, hσ _ hk, hτ _ hk, hk1,
        (hY hk.le).1, (hY hk.le).2, ite_eq_right hne, ite_eq_right hne]
      exact ⟨rfl, rfl⟩
  have hp : ∀ k ≤ a, zeta 2 a (Ys 3 S) k 0 = σ k ∧ zeta 2 a (Ys 3 S) k 1 = τ k := by
    intro k hk
    have := hpath (a - k) (by omega)
    rwa [Nat.sub_sub_self hk] at this
  have h := energy_eq_chain 3 a hP (by norm_num) S
  push_cast at h
  rw [h]
  have hsum' : ∑ k ∈ Finset.range a, Fp 3 (zeta 2 a (Ys 3 S) k 0 - zeta 2 a (Ys 3 S) (k + 1) 0)
      (zeta 2 a (Ys 3 S) k 1 - zeta 2 a (Ys 3 S) (k + 1) 1) =
      ∑ k ∈ Finset.range a, Fp 3 (σ k - σ (k + 1)) (τ k - τ (k + 1)) := by
    refine Finset.sum_congr rfl fun k hk => ?_
    have hk' := Finset.mem_range.1 hk
    rw [(hp k hk'.le).1, (hp k hk'.le).2, (hp (k + 1) hk').1, (hp (k + 1) hk').2]
  rw [hsum', (hp 0 (by omega)).1, (hp 0 (by omega)).2]
  obtain ⟨-, htop'⟩ := Q3_top ha
  have h2 : (2 : ℝ) ^ a = 2 * 2 ^ (a - 1) := by
    rw [← pow_succ']; congr 1; omega
  rw [← htop', h2]
  nlinarith [pow_pos (by norm_num : (0 : ℝ) < 2) (a - 1)]

/-- **The maximal energy of `ICG(2^a P, S)` for every odd prime `P` and `a ≥ 2`.** -/
theorem energy_max_odd {P a : ℕ} (hP : P.Prime) (hP2 : P ≠ 2) (ha : 2 ≤ a) :
    (∀ S ⊆ (2 ^ a * P).properDivisors,
      ICGBridge.energy (ICGBridge.icgAdj (2 ^ a * P) S) (ICGBridge.icgAdj_isHermitian _ _) ≤
        Emax P a) ∧
    ∃ S ⊆ (2 ^ a * P).properDivisors,
      ICGBridge.energy (ICGBridge.icgAdj (2 ^ a * P) S) (ICGBridge.icgAdj_isHermitian _ _) =
        Emax P a := by
  rcases Nat.lt_or_ge P 5 with h | h
  · have h3 : P = 3 := by
      have := hP.two_le
      interval_cases P <;> first | rfl | exact absurd rfl hP2 | exact absurd hP (by norm_num)
    subst h3
    simpa using energy_max_three ha
  · exact energy_max hP h ha

